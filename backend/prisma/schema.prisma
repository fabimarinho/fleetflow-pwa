generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  GESTOR
  MOTORISTA
}

enum StatusVeiculo {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
}

enum StatusViagem {
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum TipoCombustivel {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV
  FLEX
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

enum StatusManutencao {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  nome  String
  email String @unique
  senha String

  matricula String?
  telefone  String?

  perfil Perfil  @default(MOTORISTA)
  ativo  Boolean @default(true)

  secretariaId String?     @db.Uuid
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  viagens        Viagem[]        @relation("MotoristaViagens")
  abastecimentos Abastecimento[] @relation("MotoristaAbastecimentos")
  manutencoes    Manutencao[]    @relation("ResponsavelManutencoes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([secretariaId])
  @@map("users")
}

model Secretaria {
  id String @id @default(uuid()) @db.Uuid

  nome  String  @unique
  sigla String?

  ativa Boolean @default(true)

  usuarios       User[]
  veiculos       Veiculo[]
  viagens        Viagem[]
  abastecimentos Abastecimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("secretarias")
}

model Veiculo {
  id String @id @default(uuid()) @db.Uuid

  placa  String  @unique
  modelo String
  marca  String?
  ano    Int?
  tipo   String?
  cor    String?

  kmAtual Int @default(0)

  status StatusVeiculo @default(DISPONIVEL)

  secretariaId String?     @db.Uuid
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  observacoes String?

  proximoOleoKm    Int?
  licenciamentoAte DateTime? @db.Date
  ipvaAte          DateTime? @db.Date
  seguroAte        DateTime? @db.Date

  viagens        Viagem[]
  abastecimentos Abastecimento[]
  manutencoes    Manutencao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([secretariaId])
  @@index([status])
  @@map("veiculos")
}

model Viagem {
  id String @id @default(uuid()) @db.Uuid

  numero BigInt @unique @default(autoincrement())

  veiculoId String  @db.Uuid
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  motoristaId String @db.Uuid
  motorista   User   @relation("MotoristaViagens", fields: [motoristaId], references: [id], onDelete: Restrict)

  secretariaId String?     @db.Uuid
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  servidorNome      String?
  servidorMatricula String?

  origem   String
  destino  String
  objetivo String?

  kmSaida   Int
  kmRetorno Int?

  horaSaida   DateTime  @default(now())
  horaChegada DateTime?

  fotoHodometroSaidaUrl   String?
  fotoHodometroRetornoUrl String?

  assinaturaUrl        String?
  assinaturaRetornoUrl String?

  checklistSaida   Json?
  checklistRetorno Json?

  combustivel String?
  ocorrencias String?

  status StatusViagem @default(EM_ANDAMENTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([veiculoId])
  @@index([motoristaId])
  @@index([secretariaId])
  @@index([status])
  @@index([horaSaida])
  @@map("viagens")
}

model Abastecimento {
  id String @id @default(uuid()) @db.Uuid

  veiculoId String  @db.Uuid
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  motoristaId String? @db.Uuid
  motorista   User?   @relation("MotoristaAbastecimentos", fields: [motoristaId], references: [id], onDelete: SetNull)

  secretariaId String?     @db.Uuid
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  data DateTime @default(now())

  km Int

  tipoCombustivel TipoCombustivel

  litros     Decimal @db.Decimal(10, 3)
  valorLitro Decimal @db.Decimal(10, 3)
  valorTotal Decimal @db.Decimal(12, 2)

  posto       String?
  observacoes String?
  cupomUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([veiculoId])
  @@index([motoristaId])
  @@index([secretariaId])
  @@index([data])
  @@map("abastecimentos")
}

model Manutencao {
  id String @id @default(uuid()) @db.Uuid

  veiculoId String  @db.Uuid
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  tipo   TipoManutencao
  status StatusManutencao @default(ABERTA)

  descricao String
  oficina   String?

  km    Int?
  custo Decimal? @db.Decimal(12, 2)

  dataAbertura  DateTime  @default(now())
  dataConclusao DateTime?

  responsavelId String? @db.Uuid
  responsavel   User?   @relation("ResponsavelManutencoes", fields: [responsavelId], references: [id], onDelete: SetNull)

  anexoUrl    String?
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([veiculoId])
  @@index([responsavelId])
  @@index([status])
  @@index([dataAbertura])
  @@map("manutencoes")
}
